-- Script <yymmdd>.sql — nombre del fichero = fecha (yymmdd). Sin migraciones.
-- Lo ya definido en este fichero NO se modifica: los cambios del mismo día se añaden al final con ALTER.
-- Las contraseñas NO se escriben aquí: se pasan como variables de psql (-v admin_password=... etc.).

CREATE DATABASE __PRODUCT_NAME__;  -- ejecutar conectado a la base de datos 'postgres'

CREATE ROLE __PRODUCT_NAME___admin LOGIN PASSWORD :'admin_password';
CREATE ROLE __PRODUCT_NAME___app LOGIN PASSWORD :'app_password';
CREATE ROLE __PRODUCT_NAME___maintenance LOGIN PASSWORD :'maintenance_password';

ALTER DATABASE __PRODUCT_NAME__ OWNER TO __PRODUCT_NAME___admin;

